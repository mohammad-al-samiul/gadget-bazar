# Root Environment Variables Template (No Secrets)

# Node Environment
NODE_ENV=development

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://gadgetbazar_user:gadgetbazar_pass@localhost:5432/gadgetbazar?schema=public

# Redis & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Search (Elasticsearch)
ELASTICSEARCH_NODE=http://localhost:9200

# App URLs
API_BASE_URL=http://localhost:4000/v1
WEB_BAZAR_URL=http://localhost:3000
WEB_ONE_URL=http://localhost:3001
WEB_TRACK_URL=http://localhost:3002
WEB_X_URL=http://localhost:3003

# SSLCommerz Payment Gateway (Sandbox Credentials)
SSLCOMMERZ_STORE_ID=your_test_store_id
SSLCOMMERZ_STORE_PASSWORD=your_test_store_password
SSLCOMMERZ_IS_SANDBOX=true

# JWT Auth
JWT_SECRET=development_jwt_secret_placeholder_replace_in_env
JWT_EXPIRES_IN=7d
