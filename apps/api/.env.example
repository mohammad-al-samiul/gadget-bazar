# Server Port
PORT=4000
NODE_ENV=development

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://gadgetbazar_user:gadgetbazar_pass@localhost:5432/gadgetbazar?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# SSLCommerz Payment Gateway (Sandbox)
SSLCOMMERZ_STORE_ID=test_store_id
SSLCOMMERZ_STORE_PASSWORD=test_store_password
SSLCOMMERZ_IS_SANDBOX=true

# JWT Auth
JWT_SECRET=super_secret_development_key_change_in_production
JWT_EXPIRES_IN=7d
